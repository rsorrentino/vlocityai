{
  "name": "vlocity-datapack-manager",
  "version": "1.0.0",
  "description": "Modern Node.js application for managing Vlocity DataPack exports and deployments",
  "main": "server/index.js",
  "scripts": {
    "start": "node --max-http-header-size=32768 server/index.js",
    "dev": "nodemon --exec \"node --max-http-header-size=32768\" server/index.js",
    "build": "npm --prefix client run build",
    "install-client": "npm --prefix client install",
    "dev-full": "node scripts/dev-full-auto-ports.js",
    "client-dev": "npm --prefix client start",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=__tests__/(services|utils|middleware)",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:verbose": "jest --verbose --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint server scripts --max-warnings 0",
    "format": "prettier --write server/ client/src/",
    "install-vlocity": "npm install -g vlocity",
    "install-sfdx": "npm install -g @salesforce/cli",
    "install-cli-tools": "npm install -g @salesforce/cli vlocity",
    "db:migrate": "node server/db/migrator.js up",
    "db:migrate:undo": "node server/db/migrator.js down",
    "db:migrate:status": "node server/db/migrator.js status",
    "check-cli-tools": "node scripts/check-cli-tools.js",
    "setup": "npm install && npm run install-client",
    "install-vlocity-windows": "powershell -ExecutionPolicy Bypass -File install-vlocity-cli-windows.ps1",
    "install-postgresql-windows": "powershell -ExecutionPolicy Bypass -File install-postgresql-windows.ps1",
    "install-all-windows": "npm run install-vlocity-windows && npm run install-postgresql-windows",
    "create-users": "node scripts/create-default-users.js",
    "migrate-job-context": "node scripts/migrate-job-context.js",
    "migrate-job-abort-status": "node scripts/migrate-job-abort-status.js",
    "migrate-cli-type": "node scripts/migrate-cli-type.js",
    "migrate-snapshot-type": "node scripts/migrate-snapshot-job-type.js",
    "migrate-sfdmu-type": "node scripts/migrate-sfdmu-job-type.js",
    "migrate-create-orgs": "node scripts/create-orgs-table.js",
    "fix-vlocity-errors": "node scripts/fix-vlocity-errors.js",
    "clean-log-ansi": "node scripts/clean-log-ansi-codes.js",
    "setup-postgresql": "node scripts/setup-postgresql.js",
    "postinstall": "node scripts/check-cli-tools.js",
    "lint:fix": "eslint server scripts --fix"
  },
  "keywords": [
    "vlocity",
    "salesforce",
    "datapack",
    "omnistudio",
    "deployment"
  ],
  "author": "DataPack Manager Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@sentry/node": "^7.99.0",
    "@sentry/profiling-node": "^1.3.4",
    "archiver": "^6.0.1",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.6",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-slow-down": "^2.0.1",
    "express-validator": "^7.0.1",
    "fs-extra": "^11.1.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.38.0",
    "pdfkit": "^0.14.0",
    "pg": "^8.16.3",
    "prom-client": "^15.0.0",
    "redis": "^4.7.1",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3",
    "undici": "^6.29.1",
    "unzipper": "^0.10.14",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.23.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  }
}
