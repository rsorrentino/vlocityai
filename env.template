# Environment Configuration Template
# Copy this file to .env and update the values.
# Works the same on Windows, macOS and Linux.

NODE_ENV=development
PORT=3001

# ── Security ────────────────────────────────────────────────────────────────
# REQUIRED in production (>= 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a random secret is generated and kept in DATA_DIR/.jwt-secret.
JWT_SECRET=
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12
# Optional separate key for encrypting stored AI tokens (defaults to JWT_SECRET).
# Changing it (or JWT_SECRET) disconnects every user's GitHub Copilot sign-in.
APP_ENCRYPTION_KEY=

# Initial administrator, created on the first start when the database has no users.
# If ADMIN_PASSWORD is empty a random password is written to DATA_DIR/initial-admin-password.txt
# Password policy: 12+ characters with upper case, lower case and a digit.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Storage ─────────────────────────────────────────────────────────────────
# Folder for the SQLite database, generated secrets and the initial admin password
# (default: ./data). Use an absolute path when running as a service.
DATA_DIR=

# Database. Leave DATABASE_URL empty and set the DB_* values for PostgreSQL, or use SQLite:
#   DATABASE_URL=sqlite:./data/vlocity_manager.db
# When PostgreSQL is configured but unreachable the app falls back to SQLite.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vlocity_manager
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=vlocity_datapack_manager

# Used by docker-compose.yml only
POSTGRES_DB=vlocity_manager
POSTGRES_USER=vlocity
POSTGRES_PASSWORD=

# Optional cache. Redis is not required; caching is disabled when it is unavailable.
REDIS_URL=redis://localhost:6379
# Linux only: try "service redis-server start" for a localhost Redis (set false to skip)
REDIS_AUTOSTART=true

# ── Salesforce / Vlocity ────────────────────────────────────────────────────
# Orgs are managed in the UI (Organization Management) and synced from the SF CLI.
VLOCITY_VERSION=1.17.12
VLOCITY_TIMEOUT=300000
# Force a specific Salesforce CLI executable (default: auto-detect sf, then sfdx)
SF_CLI_COMMAND=

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_MAX_SIZE=5242880
LOG_MAX_FILES=5

# ── File upload ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE=50mb
UPLOAD_PATH=./uploads

# ── Monitoring ──────────────────────────────────────────────────────────────
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_ENTERPRISE_MONITORING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_ENTERPRISE_JOB_QUEUE=true
AUDIT_RETENTION_DAYS=365
AUDIT_BATCH_SIZE=100
MAX_CONCURRENT_JOBS=10
MAX_JOBS_PER_USER=5
MAX_JOBS_PER_TENANT=20

# ── AI chat adapters ────────────────────────────────────────────────────────
# Users can also enter their own keys in the chat settings (kept in their browser).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub Copilot: users normally click "Sign in with GitHub" in the chat settings.
# Optional server-wide fallback: a GitHub OAuth token (gho_/ghu_) of a Copilot user.
# Personal access tokens (ghp_/github_pat_) are NOT accepted by Copilot.
GITHUB_COPILOT_TOKEN=
# Single-user desktop installs only: reuse the Copilot sign-in of VS Code / JetBrains
# on this machine (every app user would share it).
COPILOT_USE_LOCAL_TOKEN=false
COPILOT_DEFAULT_MODEL=gpt-4.1
# Only change if your organisation provides its own Copilot-enabled OAuth app
COPILOT_OAUTH_CLIENT_ID=
# GitHub Enterprise Server: set both (e.g. https://github.example.com and https://github.example.com/api/v3)
GITHUB_BASE_URL=
GITHUB_API_URL=

# GitHub Models (official OpenAI-compatible endpoint): fine-grained PAT with "Models: read"
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_DEFAULT_MODEL=openai/gpt-4.1

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Outbound proxy for AI providers (also read from the standard variables)
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
# Set to false to ignore HTTPS_PROXY for AI calls
AI_HTTP_PROXY=true

# Default adapter shown to new users
DEFAULT_AI_ADAPTER=anthropic
DEFAULT_AI_MODEL=claude-sonnet-4-6
